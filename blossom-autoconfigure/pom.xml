<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.blossom-project</groupId>
    <artifactId>blossom-parent</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <relativePath>../blossom-parent</relativePath>
  </parent>

  <artifactId>blossom-autoconfigure</artifactId>
  <packaging>jar</packaging>

  <name>Blossom AutoConfigure</name>
  <url>http://maven.apache.org</url>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-liquibase</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jdbc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-hibernate</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-mail</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-quartz</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-security</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-servlet</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-persistence</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jpa</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-metrics</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-core-common</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-core-user</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-core-group</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-core-association-user-group</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-core-association-user-role</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-core-scheduler</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-core-cache</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-core-validation</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-ui-common</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-ui-supervision</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-ui-api</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-ui-web</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-module-filemanager</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-module-articles</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-module-bpmn</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.blossom-project</groupId>
      <artifactId>blossom-core-crypto</artifactId>
      <version>4.0.0-SNAPSHOT</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <artifactId>blossom-module-search-common</artifactId>
      <groupId>com.blossom-project</groupId>
      <optional>true</optional>
      <version>4.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <artifactId>blossom-module-search-elasticsearch</artifactId>
      <groupId>com.blossom-project</groupId>
      <optional>true</optional>
      <version>4.0.0-SNAPSHOT</version>
    </dependency>

    <!-- Generate spring-configuration-metadata.json on process -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
