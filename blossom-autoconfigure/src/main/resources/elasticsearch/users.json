{
  "settings": {
    "number_of_shards": "1",
    "number_of_replicas": "0",
    "index": {
      "analysis": {
        "filter": {
          "suggest_edgengram_filter": {
            "type": "edgeNGram",
            "min_gram": 1,
            "max_gram": 20
          }
        },
        "analyzer": {
          "email": {
            "tokenizer": "lowercase",
            "filter": [
              "lowercase",
              "suggest_edgengram_filter"
            ]
          },
          "default": {
            "tokenizer": "standard",
            "filter": [
              "lowercase",
              "asciifolding",
              "elision"
            ]
          },
          "suggest": {
            "tokenizer": "standard",
            "filter": [
              "lowercase",
              "asciifolding",
              "elision",
              "suggest_edgengram_filter"
            ]
          }
        }
      }
    }
  },
  "mappings": {
    "user": {
      "_all": {
        "enabled": false
      },
      "properties": {
        "summary": {
          "type": "object",
          "properties": {
            "id": {
              "type": "text",
              "index": "false"
            },
            "type": {
              "type": "text",
              "index": "false"
            },
            "name": {
              "type": "text",
              "analyzer": "suggest",
              "search_analyzer": "default"
            },
            "description": {
              "type": "text",
              "analyzer": "suggest",
              "search_analyzer": "default"
            },
            "uri": {
              "type": "text",
              "index": "false"
            }
          }
        },
        "dto": {
          "type": "object",
          "properties": {
            "id": {
              "type": "text",
              "index": "false"
            },
            "firstname": {
              "type": "text",
              "analyzer": "suggest",
              "search_analyzer": "default"
            },
            "lastname": {
              "type": "text",
              "analyzer": "suggest",
              "search_analyzer": "default"
            },
            "identifier": {
              "type": "text",
              "analyzer": "suggest",
              "search_analyzer": "default"
            },
            "email": {
              "type": "text",
              "analyzer": "email",
              "search_analyzer": "default"
            },
            "activated": {
              "type": "boolean"
            },
            "civility": {
              "type": "text"
            },
            "company": {
              "type": "text",
              "fields": {
                "raw": {
                  "type": "text",
                  "index": "false"
                }
              }
            },
            "description": {
              "type": "text"
            },
            "function": {
              "type": "text",
              "fields": {
                "raw": {
                  "type": "text",
                  "index": "false"
                }
              }
            },
            "lastConnection": {
              "type": "long"
            },
            "passwordHash": {
              "type": "text"
            },
            "phone": {
              "type": "text"
            },
            "creationDate": {
              "type": "long"
            },
            "modificationDate": {
              "type": "long"
            },
            "creationUser": {
              "type": "text",
              "index": "false"
            },
            "modificationUser": {
              "type": "text",
              "index": "false"
            }
          }
        }
      }
    }
  }
}
